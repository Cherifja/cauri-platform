# Cles recuperees sur https://app.kkiapay.me/dashboard (menu Developpeurs)
KKIAPAY_PUBLIC_KEY=votre_cle_publique
KKIAPAY_PRIVATE_KEY=votre_cle_privee
KKIAPAY_SECRET_KEY=votre_cle_secrete
KKIAPAY_SANDBOX=true

# URL de connexion Postgres (fournie par Supabase : Project Settings > Database
# > Connection string > URI). Doit ressembler a :
# postgresql://postgres:motdepasse@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/database

# Pourcentage de commission prelevee par la plateforme sur chaque reservation
COMMISSION_RATE=0.12

# Cle secrete utilisee pour signer les tokens de connexion (JWT).
# Generer une vraie valeur aleatoire en production, par exemple avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_moi_en_production

# Adresse de ton site (frontend), utilisee pour autoriser les requetes (CORS)
# et pour construire le lien envoye dans l'email de reinitialisation de
# mot de passe. En local : http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Envoi d'emails (reinitialisation de mot de passe) via l'API HTTP de Brevo
# (gratuit jusqu'a 300 emails/jour) : https://app.brevo.com
# 1. Cree un compte gratuit
# 2. Verifie ton adresse email d'envoi (Parametres > Expediteurs > Ajouter
#    un expediteur), tu recevras un email de confirmation a valider
# 3. Recupere ta cle API dans Parametres > Cles API > Generer une nouvelle cle
BREVO_API_KEY=ta_cle_api_brevo
BREVO_SENDER_EMAIL=ton-adresse@gmail.com

PORT=4000

# Cles recuperees sur https://app.kkiapay.me/dashboard (menu Developpeurs)
KKIAPAY_PUBLIC_KEY=votre_cle_publique
KKIAPAY_PRIVATE_KEY=votre_cle_privee
KKIAPAY_SECRET_KEY=votre_cle_secrete
KKIAPAY_SANDBOX=true

# URL de connexion Postgres (fournie par Supabase : Project Settings > Database
# > Connection string > URI). Doit ressembler a :
# postgresql://postgres:motdepasse@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/database

# Pourcentage de commission prelevee par la plateforme sur chaque reservation
COMMISSION_RATE=0.12

# Cle secrete utilisee pour signer les tokens de connexion (JWT).
# Generer une vraie valeur aleatoire en production, par exemple avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_moi_en_production

PORT=4000
